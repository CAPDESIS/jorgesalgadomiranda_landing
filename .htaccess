# ────────────────────────────────────────────────────────────
# jorgesalgadomiranda.com. Apache config (Hostinger shared)
# Handles: HTTPS redirect, security headers, gzip, long cache.
# ────────────────────────────────────────────────────────────

# BEGIN php-advisory-2026-10-21
# CVE-2026-109618 / CVE-2026-109619 (PHP advisory 2026-10-21, unauthenticated
# RCE in request parsing; fixed in 8.2.35, 8.3.36, 8.4.27 and 8.5.12). Hostinger
# serves api/contact.php from LiteSpeed (X-Turbo-Charged-By, measured
# 2026-10-21); the PHP version is hidden and is chosen in hPanel. Apply the
# advisory workarounds before PHP parses the request body. contact.php reads
# multipart or urlencoded form fields and accepts no file uploads, so 1M is
# above every legitimate request. php_value/php_flag are PERDIR here, so
# ini_set() cannot raise post_max_size or re-enable upload progress. Guarded
# so a server without either module ignores the block instead of answering 500.
# Contract: scripts/php-advisory-htaccess-test.sh.
<IfModule LiteSpeed>
    php_flag session.upload_progress.enabled off
    php_value memory_limit -1
    php_value post_max_size 1M
</IfModule>
<IfModule mod_php.c>
    php_flag session.upload_progress.enabled off
    php_value memory_limit -1
    php_value post_max_size 1M
</IfModule>
# END php-advisory-2026-10-21

# -------- Force HTTPS + apex → www-canonical is NOT used; we stay on apex --------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP → HTTPS (Cloudflare handles most cases; this covers direct origin hits)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → apex (Cloudflare also does this, but origin-side is a belt-and-suspenders)
  RewriteCond %{HTTP_HOST} ^www\.jorgesalgadomiranda\.com$ [NC]
  RewriteRule ^ https://jorgesalgadomiranda.com%{REQUEST_URI} [L,R=301]

  # Canonical legal URLs (LEGALS 2026-10-11): typed aliases 301 to the page
  # rendering each document.
  RewriteRule ^privacidad/?$ /legal/privacy.html [R=301,L]
  RewriteRule ^terminos/?$ /legal/terms.html [R=301,L]
  RewriteRule ^privacy/?$ /legal/privacy.html [R=301,L]
  RewriteRule ^terms/?$ /legal/terms.html [R=301,L]
</IfModule>

# -------- Security headers --------
<IfModule mod_headers.c>
  # 2 years, preload. Only enable preload after you're 100% on HTTPS permanently.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Legacy but cheap. Disallow MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Don't allow framing. Prevents clickjacking.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Referrer leak budget. Keep origin only
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Browsers: disable features we don't use. Expand if you add a use case.
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()"

  # Content-Security-Policy, deliberately permissive enough for inline styles/scripts
  # that this single-file HTML relies on. Tighten after separating out scripts/styles.
  # Allowed third-parties: analytics (umami self-host + cloudflare beacon),
  # booking (cal.com), external images we intentionally hotlink.
  # Contact form posts same-origin to /api/contact.php (Resend server-side).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://stats.capdesis.com https://static.cloudflareinsights.com https://app.cal.com https://cal.com https://us-assets.i.posthog.com https://eu-assets.i.posthog.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://capdesis.com https://*.capdesis.com https://stats.capdesis.com https://jorgesalgadomiranda.com; font-src 'self' data:; connect-src 'self' https://stats.capdesis.com https://cloudflareinsights.com https://app.cal.com https://us.i.posthog.com https://eu.i.posthog.com https://challenges.cloudflare.com; frame-src https://cal.com https://app.cal.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # Remove server banner signal
  Header unset X-Powered-By
</IfModule>

# -------- Hide sensitive files --------
# Any file whose name starts with a dot: .htaccess, .env*, .git*, repo tooling
# such as .pre-commit-config.yaml, and the FTP deploy action's own
# .ftp-deploy-sync-state.json (a full file list with hashes, which the action
# reads over FTP, never over HTTP). Files inside .well-known/ do not start with
# a dot, so ACME and security.txt stay reachable.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "(\.(md|markdown)$|^(package\.json|bun\.lockb|package-lock\.json|og\.html)$)">
  Require all denied
</FilesMatch>
# Never serve contact secrets or PHP helpers directly.
<FilesMatch "^(secrets\.php|secrets\.example\.php)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^api/lib/ - [F,L]
</IfModule>

# -------- Gzip / Brotli (Hostinger supports both; mod_deflate is safest) --------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

# -------- Long cache for immutable assets (fonts, images) --------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/xhtml+xml "access plus 5 minutes"
  ExpiresByType application/xml "access plus 5 minutes"
  ExpiresByType text/xml "access plus 5 minutes"
  ExpiresDefault "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
  # HTML and XML: keep TTL short so a new deploy is visible within minutes,
  # not 24 hours. CSS/JS are versioned per deploy via ?v=SHA in the workflow
  # so browsers pull fresh bytes regardless; HTML is the entry point that
  # carries the new asset URLs, so it must not be pinned by CDN edges.
  <FilesMatch "\.(html|htm|xml)$">
    Header set Cache-Control "public, max-age=300, s-maxage=300, must-revalidate"
  </FilesMatch>
  # Parity marker: a cached version.json would report the previous deploy
  # as current, so it is never stored by browsers or edges.
  <FilesMatch "^version\.json$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# -------- Nice URL handling --------
DirectoryIndex index.html

# -------- Custom 404 page --------
# Branded, bilingual (EN + ES stacked, no JS needed) recovery page with
# links home and to both CVs. Served for any path Apache cannot resolve.
ErrorDocument 404 /404.html
